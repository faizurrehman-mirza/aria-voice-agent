# Copy this file to `.env` and paste your real key.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Only needed when deploying. Locally everything below can stay unset. ---

# Signs cookies. Generate a new one for the server and never reuse the
# development value:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# "false" on the server, so an error never shows our source code to a visitor.
# DJANGO_DEBUG=false

# The domain the API answers on, comma separated.
# DJANGO_ALLOWED_HOSTS=aria-voice-agent-api.vercel.app

# The deployed frontend's address, so its browser is allowed to call this API.
# CORS_ALLOWED_ORIGINS=https://aria-voice-agent.vercel.app
